#!/usr/bin/env python3
"""Turn the append-only workspace logs into individually addressable ITEMS.

FINDINGS.md and AGENTS.md were unusable not because they were large but because they had
the wrong shape: the unit of a finding is a BULLET buried inside a batch section, so no
finding could be linked, closed, counted or filed by area. The unit of an AGENTS entry is
an announcement whose lifetime ranges from hours (a claim) to zero (a "SHIPPED" line that
duplicates a commit).

This extracts one file per item, each carrying frontmatter so all four axes are directly
greppable:

    area:   which repo/subsystem it is about   (grep -rl 'area: ce-canvas')
    status: open | fixed                       (grep -rl 'status: open')
    kind:   defect | trap | gap | measurement  (findings)
            claim | message | shipped | lesson (agents)
    date:   when it was recorded

Nothing is summarized or dropped; an item's body is copied verbatim, and anything the
classifier cannot place lands in area `unsorted` where it is visible rather than silently
misfiled.

It deliberately generates NO index files. A generated index is a cache with no
invalidation — stale the moment anyone edits an item — and the real index belongs in a
database (ce-db) fed by tailing `ce-drive changes`, not in markdown someone must remember
to rebuild. Until that exists, the frontmatter IS the query surface: every field is
greppable through `ce.files`.

Note on where these fields live: status/area/kind are DOMAIN fields, so they live inside
the document, in its own language, for a parser to extract. They are not file metadata.
The only things that belong on a ce-drive file itself are what an indexer must know before
it can parse (what kind of thing this is) and what applies to files it can never parse
(tags, links) — a JPEG has nowhere to put frontmatter.

    tools/log-to-items FINDINGS.md --out items/findings --apply
    tools/log-to-items AGENTS.md   --out items/agents   --apply
"""
from __future__ import annotations

import argparse
import os
import re
import sys
from collections import Counter

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

DATE = re.compile(r"(\d{4}-\d{2}-\d{2})")
AGENT = re.compile(r"\(([A-Z][A-Za-z-]+)(?:,[^)]*)?\)")
STATUS_TAG = re.compile(r"\[(OPEN|FIXED|DONE|RESOLVED|SHIPPED|WONTFIX)\]", re.I)
PAREN_AREA = re.compile(r"^\s*\((?!verbatim|Leif|his )([^)]{2,40})\)\s*")

# subsystems that are not repo directories
EXTRA_AREAS = {
    "node": "node", "substrate": "node", "appmgr": "node", "ce-appmgr": "node",
    "caps": "node", "capability": "node", "mesh": "node", "dht": "node",
    "blob": "node", "blobs": "node", "lane": "node", "ce-lane": "node",
    "tooling": "tooling", "dev tooling": "tooling", "ci": "tooling",
    "docs": "docs", "workspace": "workspace", "skills": "docs",
}

FIXED_WORDS = re.compile(
    r"\b(fixed|FIXED|resolved|RESOLVED|shipped|SHIPPED|done|DONE|landed|closed)\b")
TRAP_WORDS = re.compile(
    r"\b(beware|gotcha|footgun|trap|lesson|META:|the lesson|worth knowing|caveat)\b", re.I)
GAP_WORDS = re.compile(
    r"\b(missing|there is no|no way to|should (be|have|exist)|needs a|too hard|"
    r"we lack|not implemented|unimplemented|wanted|would want)\b", re.I)
MEASURE_WORDS = re.compile(r"\b\d+(\.\d+)?\s?(ms|s|KB|MB|GB|%|x)\b")


def slug(text, n=70):
    text = re.sub(r"`[^`]*`", " ", text)
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:n] or "item"


class Item:
    def __init__(self, body, date, agent, section, areas_vocab, mode):
        self.body = body.rstrip()
        self.date = date
        self.agent = agent
        self.section = section
        self.mode = mode
        self.status = self._status()
        self.area = self._area(areas_vocab)
        self.kind = self._kind()
        self.title = self._title()

    # -- classification -----------------------------------------------------
    def _status(self):
        m = STATUS_TAG.search(self.body[:120])
        if m:
            return "open" if m.group(1).upper() == "OPEN" else "fixed"
        if re.match(r"^#{0,3}\s*(Open)\s*$", self.section, re.I):
            return "open"
        if re.match(r"^#{0,3}\s*(Fixed)\s*$", self.section, re.I):
            return "fixed"
        head = self.body[:200]
        if FIXED_WORDS.search(head) and not re.search(r"\bnot (yet )?fixed\b", head, re.I):
            return "fixed"
        return "open"

    def _area(self, vocab):
        """Priority: an explicit (area) tag, then a named repo, then the batch heading,
        then a generic subsystem word. Generic words like 'mesh' or 'caps' are a LAST
        resort — letting them compete with repo names filed a quarter of everything
        under 'node'."""
        repos = {k: v for k, v in vocab.items() if k not in EXTRA_AREAS}

        # 1. the explicit convention: "- [OPEN] (ce-appmgr) ..."
        m = PAREN_AREA.search(re.sub(r"^\s*-\s*(\[[A-Z]+\]\s*)?", "", self.body))
        if m:
            raw = m.group(1).strip().lower()
            for part in re.split(r"[/,+]| and ", raw):
                part = part.strip()
                if part in repos:
                    return repos[part]
                if part in EXTRA_AREAS:
                    return EXTRA_AREAS[part]

        def scan(text, table, minlen=5):
            hits = Counter()
            for name, area in table.items():
                if len(name) < minlen:
                    continue
                n = len(re.findall(
                    r"(?<![a-z0-9-])" + re.escape(name) + r"(?![a-z0-9-])", text))
                if n:
                    hits[area] += n
            return hits

        # 2. a repo named in the item itself (most mentions wins)
        body = self.body[:1200].lower()
        hits = scan(body, repos)
        if hits:
            return hits.most_common(1)[0][0]

        # 3. a repo named in the heading of the batch it came from
        hits = scan(self.section.lower(), repos)
        if hits:
            return hits.most_common(1)[0][0]

        # 4. only now, a generic subsystem word
        hits = scan(body + " " + self.section.lower(), EXTRA_AREAS)
        if hits:
            return hits.most_common(1)[0][0]
        return "unsorted"

    def _kind(self):
        head = self.body[:400]
        if self.mode == "agents":
            if re.search(r"\b(SHIPPED|DONE|FIXED|live-verified|pushed)\b", head):
                return "shipped"
            if re.search(r"\bCLAIM|claiming|I am taking|taking the\b", head, re.I):
                return "claim"
            if re.search(r"@[A-Z][a-z]+", head):
                return "message"
            return "lesson"
        if TRAP_WORDS.search(head):
            return "trap"
        if MEASURE_WORDS.search(head) and re.search(
                r"\b(median|latency|benchmark|measured|throughput|took|cold|warm)\b", head, re.I):
            return "measurement"
        if GAP_WORDS.search(head):
            return "gap"
        return "defect"

    def _title(self):
        t = self.body.split("\n", 1)[0]
        t = re.sub(r"^#{1,6}\s*", "", t)
        t = re.sub(r"^\s*-\s*", "", t)
        t = STATUS_TAG.sub("", t)
        t = PAREN_AREA.sub("", t)
        t = re.sub(r"\*\*(.+?)\*\*", r"\1", t)
        t = re.sub(r"`([^`]*)`", r"\1", t)
        return t.strip(" .—-") or "untitled"


def repo_vocab():
    vocab = {}
    for name in sorted(os.listdir(ROOT)):
        if not os.path.isdir(os.path.join(ROOT, name)) or name.startswith("."):
            continue
        if name in ("trash", "node_modules", "target", "items"):
            continue
        vocab[name.lower()] = name
    vocab.update({k: v for k, v in EXTRA_AREAS.items()})
    return vocab


def split_items(path, mode, vocab):
    """A findings item is a top-level bullet; an agents item is a section."""
    lines = open(path, encoding="utf-8").read().split("\n")
    heads = [i for i, l in enumerate(lines) if l.startswith("## ")]
    items = []
    for n, start in enumerate(heads):
        end = heads[n + 1] if n + 1 < len(heads) else len(lines)
        head = lines[start][3:].strip()
        d = DATE.search(head)
        date = d.group(1) if d else ""
        a = AGENT.search(head)
        agent = a.group(1) if a else ""
        block = lines[start + 1:end]

        if mode == "agents":
            items.append(Item("\n".join(lines[start:end]), date, agent, head, vocab, mode))
            continue

        # findings: carve top-level bullets out of the section
        bullets, cur = [], None
        preface = []
        for l in block:
            if re.match(r"^-\s+\S", l):
                if cur:
                    bullets.append(cur)
                cur = [l]
            elif cur is not None and (l.startswith("  ") or l.startswith("\t") or not l.strip()):
                cur.append(l)
            elif cur is not None:
                bullets.append(cur); cur = None; preface.append(l)
            else:
                preface.append(l)
        if cur:
            bullets.append(cur)

        if bullets:
            pre = "\n".join(preface).strip()
            for b in bullets:
                body = "\n".join(b).rstrip()
                if len(body) < 40:            # too short to be a finding on its own
                    continue
                it = Item(body, date, agent, head, vocab, mode)
                it.context = (head, pre[:400])
                items.append(it)
        else:
            body = "\n".join(lines[start:end]).rstrip()
            if len(body) > 60:
                it = Item(body, date, agent, head, vocab, mode)
                it.context = (head, "")
                items.append(it)
    return items


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("path")
    ap.add_argument("--out", required=True)
    ap.add_argument("--mode", choices=["findings", "agents"])
    ap.add_argument("--apply", action="store_true")
    args = ap.parse_args()

    mode = args.mode or ("agents" if "AGENT" in os.path.basename(args.path).upper()
                         else "findings")
    vocab = repo_vocab()
    items = split_items(os.path.join(ROOT, args.path), mode, vocab)

    print(f"{args.path}: {len(items)} items ({mode})")
    for axis in ("status", "kind"):
        c = Counter(getattr(i, axis) for i in items)
        print(f"  {axis:7} " + "  ".join(f"{k}={v}" for k, v in c.most_common()))
    areas = Counter(i.area for i in items)
    print(f"  areas   {len(areas)} distinct; top: " +
          ", ".join(f"{k}={v}" for k, v in areas.most_common(12)))
    print(f"  unsorted {areas.get('unsorted', 0)} "
          f"({100 * areas.get('unsorted', 0) // max(1, len(items))}%)")
    if not args.apply:
        print("\n(dry run)")
        return 0

    out = os.path.join(ROOT, args.out)
    os.makedirs(out, exist_ok=True)
    seen = Counter()
    written = []
    for it in items:
        base = slug(it.title)
        seen[(it.area, base)] += 1
        if seen[(it.area, base)] > 1:
            base = f"{base}-{seen[(it.area, base)]}"
        rel = os.path.join(it.area if mode == "findings" else (it.agent or "unattributed"),
                           (f"{it.date}-" if mode == "agents" and it.date else "") + base + ".md")
        p = os.path.join(out, rel)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        ctx = getattr(it, "context", ("", ""))
        fm = [
            "---",
            f"title: {it.title[:200]}",
            f"area: {it.area}",
            f"status: {it.status}",
            f"kind: {it.kind}",
            f"date: {it.date or 'undated'}",
            f"agent: {it.agent or 'unattributed'}",
            f"source: {os.path.basename(args.path)}",
            f"section: {ctx[0][:160]}" if ctx[0] else "section:",
            "---",
            "",
        ]
        body = it.body
        if ctx[1]:
            body += f"\n\n---\n\nContext from the batch it was recorded in:\n\n{ctx[1]}\n"
        open(p, "w", encoding="utf-8").write("\n".join(fm) + body.rstrip() + "\n")
        written.append((rel, it))

    print(f"\nwrote {len(written)} item files under {args.out}/ (no indexes by design)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
