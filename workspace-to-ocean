#!/usr/bin/env python3
"""Move the workspace's backlog, log, plans and notes into Ocean — once, without duplicates.

    tools/workspace-to-ocean --dry-run          # show exactly what would be created
    tools/workspace-to-ocean                    # do it (idempotent; re-running adds nothing)
    tools/workspace-to-ocean --only backlog     # one source at a time

Sources and where they land, under org "Rydenfalk":

    FINDINGS.md  [OPEN]  items      -> Backlog / Todo / <one doc per item>
    FINDINGS.md  [FIXED] items      -> Backlog / Completed / <one doc per item>
    FINDINGS.md  dated sections     -> Log / Investigations / <one doc per section>
    AGENTS.md    ## entries         -> Log / Agent log / <one doc per entry>
    PLAN/*.md                       -> Plans / <one doc per file>
    notes/*.md                      -> Notes / <one doc per file>

Every write goes through Ocean.ensure_doc, which matches on (parent, normalized title)
against an index built from ONE doc.tree call. A document that is already there is left
alone. That is what makes this safe to run again after a partial run, and what stops a
second copy of the backlog appearing next to the first.

Backlog items keep their state by WHICH FOLDER THEY ARE IN, not by a status field in the
text. Moving an item from Todo to Started is `doc.move` — one call, and the item's history,
links and backlinks come with it.
"""
from __future__ import annotations

import argparse
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "tools"))
from oceanlib import Ocean, title_from  # noqa: E402

# The live FINDINGS.md / AGENTS.md are TOMBSTONES now — pointers to Ocean, not content.
# Reading them would migrate the tombstone's own headings ("Why it moved", ...) as if they
# were findings, which it did once. The frozen pre-migration copies under archive/ are the
# real source, so prefer those and fall back only if they are missing.
def _source(name: str) -> str:
    frozen = os.path.join(ROOT, "archive", f"{name}.frozen-2026-07-26")
    return frozen if os.path.exists(frozen) else os.path.join(ROOT, name)


FINDINGS = _source("FINDINGS.md")
AGENTS = _source("AGENTS.md")
PLAN_DIR = os.path.join(ROOT, "PLAN")
NOTES_DIR = os.path.join(ROOT, "notes")

DATE_RE = re.compile(r"(\d{4}-\d{2}-\d{2})")

BACKLOG_INDEX = """\
The work queue for everyone working on ce-net, human or agent. **This replaces
`FINDINGS.md`** — that file is now a tombstone pointing here.

## How it works

An item is a **document**, and its state is **which folder it is in**. There is no status
field to forget to update.

| folder | means |
|---|---|
| **Todo** | nobody has started. Anyone may pick it up. |
| **Started** | someone is on it right now. The doc says who, and when they claimed it. |
| **Completed** | done. The doc says what actually fixed it. |

Moving between them is one call (`doc.move`), and the item keeps its history, its links and
its backlinks. Use the CLI rather than clicking:

    tools/backlog list                  # pending work: Started first, then Todo
    tools/backlog add "..." --why "..." # file something you found
    tools/backlog start <id> --by Name  # claim it
    tools/backlog done  <id> --how "..."# close it, saying what fixed it
    tools/backlog show  <id>

