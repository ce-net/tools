# --------------------------------------------------------------------------- parsing

def parse_findings_items(text: str, marker: str):
    """`- [OPEN] ...` / `- [FIXED] ...` bullets, including their indented continuations."""
    lines = text.split("\n")
    items, cur = [], None
    for line in lines:
        if line.startswith(f"- [{marker}]"):
            if cur:
                items.append("\n".join(cur))
            cur = [line]
        elif cur is not None:
            # A continuation line is indented; anything else ends the item.
            if line.startswith("  ") and line.strip():
                cur.append(line)
            else:
                items.append("\n".join(cur))
                cur = None
    if cur:
        items.append("\n".join(cur))
    return items


def item_title(raw: str, marker: str) -> str:
    """`- [OPEN] (area) description — where — why` -> `(area) description`."""
    body = " ".join(raw.split())
    body = body.replace(f"- [{marker}]", "", 1).strip()
    return title_from(body, "untitled item", split_dash=True)


def item_md(raw: str, marker: str, source_line: int) -> str:
    body = "\n".join(l[2:] if l.startswith("  ") else l for l in raw.split("\n"))
    body = body.replace(f"- [{marker}]", "", 1).strip()
    return (f"{body}\n\n---\n\n*Migrated from `FINDINGS.md` line {source_line} "
            f"(the file is now a tombstone pointing at [[Backlog]]).*\n")


def parse_sections(text: str):
    """`## heading` sections with their bodies."""
    lines = text.split("\n")
    heads = [i for i, l in enumerate(lines) if l.startswith("## ")]
    out = []
    for n, start in enumerate(heads):
        head = lines[start][3:].strip()
        end = heads[n + 1] if n + 1 < len(heads) else len(lines)
        body = "\n".join(lines[start + 1:end]).strip("\n")
        out.append((head, body, start + 1))
    return out


# --------------------------------------------------------------------------- sources

def do_backlog(o: Ocean, org, args):
    text = open(FINDINGS, encoding="utf-8").read()
    lines = text.split("\n")
    proj = o.ensure_project(org, "Backlog")
    idx, _ = o.ensure_doc("Backlog", BACKLOG_INDEX, project=proj, icon="clipboard",
                          update=True, dry=args.dry_run)
    folders = {}
    for name, md, icon in (("Todo", TODO_INDEX, "circle"),
                           ("Started", STARTED_INDEX, "hourglass"),
                           ("Completed", COMPLETED_INDEX, "check")):
        folders[name], _ = o.ensure_doc(name, md, parent=idx, icon=icon,
                                        update=True, dry=args.dry_run)

    for marker, folder in (("OPEN", "Todo"), ("FIXED", "Completed")):
        items = parse_findings_items(text, marker)
        print(f"  {marker}: {len(items)} items -> {folder}")
        for raw in items:
            first = raw.split("\n")[0]
            ln = lines.index(first) + 1 if first in lines else 0
            title = item_title(raw, marker)
            _, how = o.ensure_doc(title, item_md(raw, marker, ln),
                                  parent=folders[folder], update=args.update,
                                  dry=args.dry_run, distinct_key=f"L{ln}")
            if args.verbose or how == "created":
                print(f"    {how:8} {title[:88]}")


def do_log(o: Ocean, org, args):
    proj = o.ensure_project(org, "Log")
    idx, _ = o.ensure_doc("Log", LOG_INDEX, project=proj, icon="book",
                          update=True, dry=args.dry_run)
    agent_folder, _ = o.ensure_doc("Agent log", LOG_INDEX.split("## For agents")[1].strip(),
                                   parent=idx, icon="people", update=True, dry=args.dry_run)
    inv_folder, _ = o.ensure_doc(
        "Investigations",
        "Long-form write-ups migrated out of the bottom of `FINDINGS.md`. One document per "
        "session or incident.\n\nRelated: [[Backlog]], [[Agent log]].\n",
        parent=idx, icon="magnifier", update=True, dry=args.dry_run)

    entries = parse_sections(open(AGENTS, encoding="utf-8").read())
    print(f"  AGENTS.md: {len(entries)} entries -> Agent log")
    for head, body, ln in entries:
        title = title_from(head, f"entry at line {ln}", limit=120)
        md = f"{body}\n\n---\n\n*Migrated from `AGENTS.md` line {ln}.*\n"
        _, how = o.ensure_doc(title, md, parent=agent_folder, update=args.update,
                             dry=args.dry_run, distinct_key=f"L{ln}")
        if args.verbose or how == "created":
            print(f"    {how:8} {title[:88]}")

    ftext = open(FINDINGS, encoding="utf-8").read()
    sections = [s for s in parse_sections(ftext) if s[0] not in ("Open", "Fixed")]
    print(f"  FINDINGS.md: {len(sections)} investigation sections -> Investigations")
    for head, body, ln in sections:
        title = title_from(head, f"section at line {ln}", limit=120)
        md = f"{body}\n\n---\n\n*Migrated from `FINDINGS.md` line {ln}.*\n"
        _, how = o.ensure_doc(title, md, parent=inv_folder, update=args.update,
                             dry=args.dry_run, distinct_key=f"L{ln}")
        if args.verbose or how == "created":
            print(f"    {how:8} {title[:88]}")


def _dir_source(o: Ocean, org, args, project_name, index_md, directory, icon):
    if not os.path.isdir(directory):
        print(f"  {directory} does not exist, skipping")
        return
    proj = o.ensure_project(org, project_name)
    idx, _ = o.ensure_doc(project_name, index_md, project=proj, icon=icon,
                          update=True, dry=args.dry_run)
    files = sorted(f for f in os.listdir(directory) if f.endswith(".md"))
    print(f"  {directory}: {len(files)} files -> {project_name}")
    for fname in files:
        text = open(os.path.join(directory, fname), encoding="utf-8").read()
        title = fname[:-3]
        body = text
        for line in text.split("\n"):
            if line.startswith("# "):
                title = line[2:].strip()
                body = text.split(line, 1)[1].strip("\n")
                break
        title = title_from(title, fname[:-3], limit=120)
        md = f"{body}\n\n---\n\n*Migrated from `{os.path.basename(directory)}/{fname}`.*\n"
        _, how = o.ensure_doc(title, md, parent=idx, update=args.update, dry=args.dry_run,
                              distinct_key=fname)
        if args.verbose or how == "created":
            print(f"    {how:8} {title[:88]}")


def do_plans(o, org, args):
    _dir_source(o, org, args, "Plans", PLANS_INDEX, PLAN_DIR, "map")


def do_notes(o, org, args):
    _dir_source(o, org, args, "Notes", NOTES_INDEX, NOTES_DIR, "pencil")


SOURCES = {"backlog": do_backlog, "log": do_log, "plans": do_plans, "notes": do_notes}


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true",
                    help="show what would be created; write nothing")
    ap.add_argument("--only", action="append", choices=sorted(SOURCES),
                    help="migrate one source (repeatable)")
    ap.add_argument("--update", action="store_true",
                    help="overwrite documents that already exist (default: leave them alone)")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="print every document, not only new ones")
    a = ap.parse_args()

    o = Ocean()
    org = o.org()
    n = o.build_index()
    print(f"org {org[:12]} — indexed {n} existing documents "
          f"({'DRY RUN, nothing will be written' if a.dry_run else 'duplicates will be skipped'})")

    for name in (a.only or list(SOURCES)):
        print(f"\n== {name}")
        SOURCES[name](o, org, a)

    print(f"\n{o.summary()}")
    if o.skipped and not a.update:
        print("(existing documents were left untouched — pass --update to overwrite them)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
