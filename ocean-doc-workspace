#!/usr/bin/env python3
"""Publish the workspace-architecture page set into Ocean (org Rydenfalk / Engineering).

Idempotent (title+parent upsert), workspace-local on purpose: it hardcodes one Ocean
workspace's ids, which must never live inside a repo that travels.

Ocean dialect notes, learned the hard way: NO TABLES (a table line becomes one paragraph
blob), and `md.render` emits the doc title as the page heading — so a body that opens
with its own `# Title` renders it twice.
"""
import json
import sys

sys.path.insert(0, "/Users/07lead01/ce-net/ocean")
import ce  # noqa: E402

PROJECT = "ae50d8ea"          # Engineering
c = ce.connect().wait_ready()
TO = c.find_service("ce.ocean")[0]


def op(o, a=None, timeout=180000):
    r = json.loads(c.request(TO, "ocean/ctl", json.dumps({"op": o, "args": a or {}}),
                             timeout_ms=timeout).decode())
    if "error" in r:
        raise RuntimeError(f"{o}: {r['error']}")
    return r["result"]


_INDEX = None


ORG = "491af779"


def index():
    """One PROJECTED listing for the whole run.

    Deliberately `doc.tree`, not `doc.list`: doc.list returns whole records, which on
    this workspace is ~3.8 MB in a single mesh reply — right on the payload cliff, so it
    took 19s once and then timed out entirely. doc.tree is projected (titles and ids)
    and answers in about a second."""
    global _INDEX
    if _INDEX is None:
        _INDEX = []

        def walk(docs, parent=None):
            for d in docs or []:
                _INDEX.append({"id": d["id"], "title": d["title"], "parent": parent})
                walk(d.get("children"), d["id"])

        tree = op("doc.tree", {"org": ORG})["tree"]
        for org in tree:
            for proj in org.get("projects") or []:
                if proj["id"] == PROJECT:
                    walk(proj.get("docs"))
    return _INDEX


def upsert(title, md, parent=None):
    body = md.lstrip("\n")
    first, _, rest = body.partition("\n")
    if first.strip().lstrip("# ").strip() == title.strip():
        body = rest.lstrip("\n")
    for d in index():
        if d["title"] == title and (d.get("parent") or None) == parent:
            op("doc.update", {"doc": d["id"], "md": body})
            print(f"  updated  {d['id']}  {title}")
            return d["id"]
    args = {"title": title, "md": body}
    args["parent" if parent else "project"] = parent or PROJECT
    made = op("doc.create", args)["id"]
    index().append({"id": made, "title": title, "parent": parent})
    print(f"  created  {made}  {title}")
    return made


