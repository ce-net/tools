#!/usr/bin/env python3
"""Publish a repo's `docs/*.md` into Ocean — the ONE generic bridge, for any repo.

    tools/repo-docs-to-ocean ce-canvas-web --project Canvas [--dry-run]
    tools/repo-docs-to-ocean ce-sentinel   --project Sentinel --parent "Sentinel - ..."

THE SHAPE THIS ENFORCES (Leif's self-containment law, applied to documentation):
the markdown in the repo is the SOURCE OF TRUTH — it travels with the code to every
machine that receives the repo, and it is what a reader on a bare machine gets. Ocean
carries a PUBLISHED COPY so the workspace can read and link it without cloning
anything. Copies drift, so publishing is one idempotent command you re-run, never a
paste.

Idempotent by construction: every write goes through `oceanlib.Ocean.ensure_doc`,
which matches on (parent, normalized title) against an index built from ONE
`doc.tree` call and updates in place. Running it twice changes nothing; running it
after an edit updates exactly the documents that changed.

Titles come from each file's first `# ` heading, so renaming a heading renames the
Ocean document rather than creating a second one — keep headings stable, or expect
the old document to linger and need deleting by hand.

Ordering: files are published in filename order, so prefix them (`00-`, `01-`) when
sequence matters. A `README.md` in the docs dir becomes the project's index document
and everything else is nested under it.

Why this replaces per-repo scripts: `tools/sentinel-to-ocean` was the first of these
and hardcoded one repo, one project and one page list. A second copy of that for the
canvas would have been the third parallel system doing one job, which is exactly what
the anti-sprawl law forbids. This takes the repo and the project as arguments instead.
"""
from __future__ import annotations

import argparse
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "tools"))
from oceanlib import Ocean  # noqa: E402


def title_of(md: str, fallback: str) -> str:
    """The document's own `# ` heading — it is the dedup key, so it must be stable."""
    for line in md.splitlines():
        if line.startswith("# "):
            return " ".join(line[2:].split())
    return fallback


def main() -> int:
    ap = argparse.ArgumentParser(description="publish a repo's docs/ into Ocean")
    ap.add_argument("repo", help="repo directory name (or path) holding a docs/ folder")
    ap.add_argument("--project", required=True, help="Ocean project to publish into")
    ap.add_argument("--docs", default="docs", help="docs subdirectory (default: docs)")
    ap.add_argument("--parent", default=None,
                    help="nest under this document title inside the project")
    ap.add_argument("--icon", default=None, help="icon for the created documents")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    repo = args.repo if os.path.isdir(args.repo) else os.path.join(ROOT, args.repo)
    docs_dir = os.path.join(repo, args.docs)
    if not os.path.isdir(docs_dir):
        print(f"no {args.docs}/ in {repo} — nothing to publish", file=sys.stderr)
        return 1

    files = sorted(f for f in os.listdir(docs_dir) if f.endswith(".md"))
    if not files:
        print(f"{docs_dir} holds no .md files", file=sys.stderr)
        return 1

    ocean = Ocean()
    org = ocean.org()
    project = ocean.ensure_project(org, args.project)
    ocean.build_index()
    print(f"org {org[:8]}  project {args.project} {project[:8]}  {len(files)} file(s)")

    # A README becomes the index everything else hangs under, so the project reads as
    # one document with sections rather than a flat pile of siblings.
    parent_id = None
    if args.parent:
        parent_id = ocean.lookup(project, args.parent)
        if not parent_id:
            print(f"no document titled {args.parent!r} in {args.project}", file=sys.stderr)
            return 1
    elif "README.md" in files:
        md = open(os.path.join(docs_dir, "README.md")).read()
        title = title_of(md, args.project)
        parent_id, how = ocean.ensure_doc(title, md, project=project, icon=args.icon,
                                          update=True, dry=args.dry_run)
        print(f"  {how:8} {title}")
        files.remove("README.md")

    for name in files:
        md = open(os.path.join(docs_dir, name)).read()
        title = title_of(md, name[:-3])
        doc_id, how = ocean.ensure_doc(
            title, md,
            **({"parent": parent_id} if parent_id else {"project": project}),
            icon=args.icon, update=True, dry=args.dry_run)
        print(f"  {how:8} {title}   [{doc_id}]  <- {args.docs}/{name}")

    print(ocean.summary() + ("  (dry run)" if args.dry_run else ""))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
