#!/usr/bin/env bash
# ce-build — build/test/run a local Rust repo on a remote CE node, in a sandboxed rust container.
#
# Why: dev laptops are disk- and RAM-constrained; the mesh has nodes that aren't. This offloads
# heavy or disk-hungry cargo work onto a CE node (the Hetzner relay by default) instead of melting
# the laptop. It dogfoods the idea CE sells — run work on someone else's machine.
#
# How cross-repo deps resolve (the model — see PLAN/ce-cross-repo-deps.md):
#   CE crates live in separate repos and depend on each other via github GIT deps. A clean checkout
#   would resolve those from github (needing escape-free PUBLISHED manifests). Instead, to build YOUR
#   uncommitted WIP, we:
#     1. ask `tools/ce-dev-link --closure` for the transitive set of CE crate dirs this repo needs,
#     2. rsync the repo + that closure (+ each dep's workspace-root manifest) to the node,
#     3. run `tools/ce-dev-link` ON THE NODE so every synced repo gets a scoped `[patch]` config
#        pointing at the synced sibling source (relay-absolute paths),
#     4. mount the workspace at the SAME absolute path inside the container so those paths resolve,
#        and run cargo. No `../` rewriting, no stale-manifest games — the same mechanism as local dev.
#
# Usage:
#   tools/ce-build <repo-path> [cargo subcommand + args...]      # default: test
#   tools/ce-build ce-hub build
#   tools/ce-build ce-ratio test --release
#
# Env:
#   CE_BUILD_NODE   ssh target of the build node   (default: root@178.105.145.170, the relay)
#   CE_BUILD_IMAGE  rust docker image              (default: rust:1-bookworm — has gcc/build-essential)
#   CE_BUILD_TARGET_BUDGET_GB  cap on total build scratch on the node (default 20; 0 disables).
#                              Prunes OTHER repos' least-recently-used target-* dirs, never the
#                              CURRENT one. A single fat current-repo target is handled separately by:
#   CE_BUILD_MIN_FREE_GB  minimum free disk to keep on the node before building (default 6; 0 disables).
#                         When short, drops the CURRENT repo's regenerable debug/incremental cache +
#                         vacuums journald (never source/registry/compiled deps). Fixes the "ce target
#                         hit 44G and filled the disk to 100%, dying mid-build with a fake compile
#                         error" failure — a real ENOSPC is now reported AS a disk-full error, not code.
#   CE_BUILD_LOG_DIR  where per-repo logs are persisted (default ~/.ce-build-logs)
#
# Output + exit: the run streams to your terminal AND is tee'd to $CE_BUILD_LOG_DIR/<name>-last.log.
# A PASS/FAIL summary is printed at the end (passed/failed counts, the failing tests, the log path),
# so callers never need to redirect+grep. The script exits with cargo's REAL exit code (preserved
# through the tee via PIPESTATUS), so it still composes in scripts and CI. Re-read the last run with:
#   cat ~/.ce-build-logs/<name>-last.log
#
# Persistent state on the node (so builds are incremental and deps aren't re-downloaded):
#   /root/ce-build/cargo-registry    shared cargo registry cache
#   /root/ce-build/ws/<rel-path>     synced source mirror (repo + closure crates at workspace paths)
#   /root/ce-build/target-<name>     per-repo persistent target dir
set -euo pipefail

NODE="${CE_BUILD_NODE:-root@178.105.145.170}"
IMAGE="${CE_BUILD_IMAGE:-rust:1-bookworm}"

REPO="${1:?usage: ce-build <repo-path> [cargo args...]   (e.g. ce-build ce-hub build)}"
shift || true
CARGO_ARGS="${*:-test}"

[ -f "$REPO/Cargo.toml" ] || { echo "ce-build: $REPO has no Cargo.toml" >&2; exit 2; }
REPO_ABS="$(cd "$REPO" && pwd)"
NAME="$(basename "$REPO_ABS")"

# Workspace root = the ancestor that actually holds the dev-link tool (`tools/ce-dev-link`, the real
# ~/ce-net marker). We must NOT key on CLAUDE.md alone: a repo may carry its OWN CLAUDE.md (e.g.
# ce/CLAUDE.md), which would wrongly root that repo at itself and then fail to find tools/ce-dev-link.
# Prefer the nearest ancestor with tools/ce-dev-link; fall back to nearest CLAUDE.md, then repo parent.
WS_ROOT="$REPO_ABS"
while [ "$WS_ROOT" != "/" ] && [ ! -f "$WS_ROOT/tools/ce-dev-link" ]; do WS_ROOT="$(dirname "$WS_ROOT")"; done
if [ ! -f "$WS_ROOT/tools/ce-dev-link" ]; then
  WS_ROOT="$REPO_ABS"
  while [ "$WS_ROOT" != "/" ] && [ ! -f "$WS_ROOT/CLAUDE.md" ]; do WS_ROOT="$(dirname "$WS_ROOT")"; done
  [ -f "$WS_ROOT/CLAUDE.md" ] || WS_ROOT="$(dirname "$REPO_ABS")"
fi
REPO_REL="${REPO_ABS#"$WS_ROOT"/}"

WS="/root/ce-build/ws"   # workspace root on the node; mounted at the SAME path in the container
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=15)
# Never sync target dirs, git, node bits, or the LOCAL dev-link config (it carries laptop-absolute
# paths; the node regenerates its own with node-absolute paths in step 3).
RSYNC_EXCL=(--exclude 'target' --exclude 'target-*' --exclude .git --exclude node_modules
            --exclude dist --exclude '*.bak' --exclude '.cargo/config.toml')

DEVLINK="$WS_ROOT/tools/ce-dev-link"
[ -f "$DEVLINK" ] || { echo "ce-build: missing $DEVLINK" >&2; exit 2; }

# 1) Transitive closure of CE crate dirs this repo depends on (git + path edges), via ce-dev-link.
DEP_RELS="$(python3 "$DEVLINK" --closure "$REPO_ABS" "$WS_ROOT" | sort -u)"

echo "==> [ce-build] node=$NODE image=$IMAGE repo=$REPO_REL cargo $CARGO_ARGS"
# Say it loudly when local dev-link [patch] overrides are in play — a build that silently uses
# local WIP instead of published github sources hides published-build breakage until a bare
# machine hits it (FINDINGS 2026-07-24).
if [ -f "$REPO_ABS/.cargo/config.toml" ] && grep -q '^\[patch' "$REPO_ABS/.cargo/config.toml" 2>/dev/null; then
  echo "==> NOTE: dev-link [patch] overrides ACTIVE for $REPO_REL — building against LOCAL working trees, not published github sources (rm <repo>/.cargo/config.toml to test published)"
fi
[ -n "$DEP_RELS" ] && echo "    closure: $(echo "$DEP_RELS" | tr '\n' ' ')"
"${SSH[@]}" "$NODE" "mkdir -p /root/ce-build/cargo-registry '$WS/$REPO_REL' '/root/ce-build/target-$NAME'"

# 2) Sync the repo + every closure crate (at its workspace-relative path).
echo "==> syncing source"
rsync -az --delete -e "ssh -o BatchMode=yes" "${RSYNC_EXCL[@]}" "$REPO_ABS/" "$NODE:$WS/$REPO_REL/"
for drel in $DEP_RELS; do
  [ "$drel" = "$REPO_REL" ] && continue
  if [ -d "$WS_ROOT/$drel" ]; then
    echo "    + dep $drel"
    "${SSH[@]}" "$NODE" "mkdir -p '$WS/$drel'"
    rsync -az --delete -e "ssh -o BatchMode=yes" "${RSYNC_EXCL[@]}" "$WS_ROOT/$drel/" "$NODE:$WS/$drel/"
  else
    echo "    ! dep $drel not found at $WS_ROOT/$drel (skipping)" >&2
  fi
done

# Each closure crate that is a WORKSPACE MEMBER (e.g. ce/crates/ce-cap) needs its workspace-root
# manifest present so cargo can resolve member/workspace inheritance. Sync those root manifests only.
_ws_root() { # $1 = abs dir; prints nearest ancestor (within WS_ROOT) whose Cargo.toml has [workspace]
  local d="$1"
  while [ -n "$d" ] && [ "$d" != "/" ] && [ "$d" != "$WS_ROOT" ]; do
    if [ -f "$d/Cargo.toml" ] && grep -qE '^\[workspace\]' "$d/Cargo.toml" 2>/dev/null; then
      printf '%s\n' "${d#"$WS_ROOT"/}"; return
    fi
    d="$(dirname "$d")"
  done
}
WSROOTS="$(for drel in $DEP_RELS; do _ws_root "$WS_ROOT/$drel"; done | sort -u)"
for wsrel in $WSROOTS; do
  [ "$wsrel" = "$REPO_REL" ] && continue
  [ -f "$WS_ROOT/$wsrel/Cargo.toml" ] || continue
  echo "    + workspace-root manifest $wsrel"
  "${SSH[@]}" "$NODE" "mkdir -p '$WS/$wsrel'"
  rsync -az -e "ssh -o BatchMode=yes" "$WS_ROOT/$wsrel/Cargo.toml" "$NODE:$WS/$wsrel/Cargo.toml"
  [ -f "$WS_ROOT/$wsrel/Cargo.lock" ] && rsync -az -e "ssh -o BatchMode=yes" "$WS_ROOT/$wsrel/Cargo.lock" "$NODE:$WS/$wsrel/Cargo.lock"
done

# 3) Generate the per-repo [patch] configs ON THE NODE (node-absolute paths). Piped over ssh so the
#    tool need not be installed there; $WS is the workspace root on the node.
echo "==> wiring dev-link on node"
"${SSH[@]}" "$NODE" "python3 - '$WS' >/dev/null" < "$DEVLINK" || \
  echo "    ! ce-dev-link on node failed (python3 missing?); falling back to published github resolution" >&2

# Auto-clean: the relay is production; runaway target-* dirs filled the disk to 100% once. Bound total
# build scratch to CE_BUILD_TARGET_BUDGET_GB (default 20G) by pruning least-recently-modified target-*
# dirs (never the current repo's). Set the budget to 0 to disable.
BUDGET_GB="${CE_BUILD_TARGET_BUDGET_GB:-20}"
if [ "$BUDGET_GB" != "0" ]; then
  echo "==> auto-clean: keeping build scratch under ${BUDGET_GB}G (current: target-$NAME)"
  "${SSH[@]}" "$NODE" "
    cd /root/ce-build 2>/dev/null || exit 0
    budget=\$(( $BUDGET_GB * 1024 * 1024 ))
    total=\$(du -sk target-* 2>/dev/null | awk '{s+=\$1} END{print s+0}')
    for d in \$(ls -dtr target-* 2>/dev/null); do
      [ \"\$total\" -le \"\$budget\" ] && break
      [ \"\$d\" = \"target-$NAME\" ] && continue
      sz=\$(du -sk \"\$d\" 2>/dev/null | awk '{print \$1+0}')
      rm -rf \"\$d\" && total=\$(( total - sz )) && echo \"    pruned \$d (\$(( sz / 1024 ))MB)\"
    done
  "
fi

# Disk-headroom guard: the budget above prunes OTHER repos' targets but NEVER the current one, so a
# single fat repo target (ce's hit 44G, mostly regenerable debug/incremental) can still fill the node
# to 100% and die mid-build with a raw ENOSPC that looks like a compile error. Before building, if the
# node is below a minimum free margin, drop the CURRENT repo's incremental cache (cargo rebuilds it)
# and vacuum journald. Never touches source, the registry cache, or compiled deps. Disable with
# CE_BUILD_MIN_FREE_GB=0.
MIN_FREE_GB="${CE_BUILD_MIN_FREE_GB:-6}"
if [ "$MIN_FREE_GB" != "0" ]; then
  "${SSH[@]}" "$NODE" "
    free_gb() { df -Pk / | awk 'NR==2{printf \"%d\", \$4/1024/1024}'; }
    before=\$(free_gb)
    echo \"==> disk on \$(hostname): \${before}G free (want >= ${MIN_FREE_GB}G)\"
    if [ \"\$before\" -lt ${MIN_FREE_GB} ]; then
      inc=\$(du -sk /root/ce-build/target-$NAME/debug/incremental 2>/dev/null | awk '{print int(\$1/1024)}')
      rm -rf /root/ce-build/target-$NAME/debug/incremental /root/ce-build/target-$NAME/tmp 2>/dev/null
      { [ -n \"\$inc\" ] && [ \"\$inc\" -gt 0 ]; } && echo \"    freed target-$NAME/debug/incremental (\${inc}MB)\"
      journalctl --vacuum-size=100M >/dev/null 2>&1 || true
      after=\$(free_gb)
      echo \"    after cleanup: \${after}G free\"
      if [ \"\$after\" -lt 2 ]; then
        echo \"    ! WARNING: only \${after}G free after cleanup — build may ENOSPC.\" >&2
        echo \"      Largest scratch: du -sh /root/ce-build/target-* | sort -rh | head\" >&2
      fi
    fi
  " || true
fi

# 4) Build. Mount ws at its node-absolute path so the generated [patch] paths resolve in-container.
#    Output is tee'd to a persisted per-repo log so a summary can be printed and the full log
#    re-read without the caller hand-rolling a redirect. The REAL cargo exit is preserved via
#    PIPESTATUS (the tee must not mask it) and this script exits with it.
LOG_DIR="${CE_BUILD_LOG_DIR:-$HOME/.ce-build-logs}"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/$NAME-last.log"
echo "==> cargo $CARGO_ARGS  (in $IMAGE on $NODE)   [log: $LOG]"
set +e
"${SSH[@]}" "$NODE" "docker run --rm \
  -e CARGO_TERM_COLOR=always \
  -v '$WS':'$WS' -w '$WS/$REPO_REL' \
  -v /root/ce-build/cargo-registry:/usr/local/cargo/registry \
  -v '/root/ce-build/target-$NAME':'$WS/$REPO_REL/target' \
  '$IMAGE' sh -c 'cargo $CARGO_ARGS'" 2>&1 | tee "$LOG"
rc=${PIPESTATUS[0]}
set -e

# ----- Summary: a clear PASS/FAIL banner so the caller never has to grep the stream. Parses the
# tee'd log (ANSI stripped). The script still exits with cargo's real code for scripts/CI. -----
plain=$(sed -E 's/\x1b\[[0-9;]*m//g' "$LOG")
echo "----------------------------------------------------------------------"
# Order matters: an ENOSPC failure floods the log with "could not compile", and a TEST failure
# prints "error: test failed" — both would be mislabelled a compile error. Check disk-full FIRST,
# then test results, then real rustc diagnostics.
if echo "$plain" | grep -qi 'no space left on device'; then
  echo "==> ce-build FAILED: NODE DISK FULL on $NODE — NOT a code error, do not 'fix' the code."
  echo "    The build ran out of disk mid-compile. Free space and retry:"
  echo "      ${SSH[*]} $NODE \"du -sh /root/ce-build/target-* | sort -rh | head; df -h /\""
  echo "    (ce-build auto-prunes the current repo's incremental cache when free < ${MIN_FREE_GB}G;"
  echo "     raise CE_BUILD_MIN_FREE_GB or the node's disk if this recurs.) — full log: $LOG"
elif echo "$plain" | grep -q 'test result: FAILED'; then
  nfail=$(echo "$plain" | grep -oE '[0-9]+ failed' | awk '{s+=$1} END{print s+0}')
  npass=$(echo "$plain" | grep -oE '[0-9]+ passed' | awk '{s+=$1} END{print s+0}')
  echo "==> ce-build TESTS FAILED ($NAME): $nfail failed, $npass passed — full log: $LOG"
  echo "$plain" | grep -E 'panicked at|test .* FAILED' | grep -v 'test result' | head -10
elif echo "$plain" | grep -qE '^error\[E[0-9]+\]|could not compile'; then
  echo "==> ce-build FAILED to compile ($NAME) — full log: $LOG"
  echo "$plain" | grep -E '^error(\[|:)' | head -8
elif echo "$plain" | grep -q 'test result: ok'; then
  npass=$(echo "$plain" | grep -oE '[0-9]+ passed' | awk '{s+=$1} END{print s+0}')
  nign=$(echo "$plain" | grep -oE '[0-9]+ ignored' | awk '{s+=$1} END{print s+0}')
  echo "==> ce-build OK ($NAME): $npass passed${nign:+, $nign ignored} — full log: $LOG"
else
  # A build/run with no test summary (e.g. `build`, `run`): report by exit code alone.
  [ "$rc" -eq 0 ] && echo "==> ce-build OK ($NAME) — full log: $LOG" \
                  || echo "==> ce-build FAILED ($NAME, exit $rc) — full log: $LOG"
fi
exit "$rc"
