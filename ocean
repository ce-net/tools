#!/usr/bin/env python3
"""The Ocean workspace CLI — read and restructure the workspace from one command.

    tools/ocean                          # the whole tree, teamspace by teamspace
    tools/ocean tree <teamspace>         # one teamspace, in full
    tools/ocean find <text>              # search every document
    tools/ocean read <id>                # a document's markdown
    tools/ocean new <teamspace|id> <title> [--md -|<file>]
    tools/ocean mv <id> <teamspace|id>   # re-file a page under a teamspace or a page
    tools/ocean rm <id>                  # to the trash (recoverable)
    tools/ocean teamspace new <name>     # a new teamspace
    tools/ocean teamspace rm <name>      # a teamspace, only when it is empty

`tools/backlog` covers the work loop; this covers everything else, so that reshaping the
workspace stops meaning "write a throwaway python script that imports oceanlib".

Every write RE-READS the server to see whether it landed before retrying, because Ocean
answers slowly when the machine is loaded and a blind retry is how you get two of
something. Ids may be given by their first 8 characters.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "tools"))
from oceanlib import Ocean, norm  # noqa: E402


STATE_TOPIC = "ocean.state/ctl"


class Workspace:
    def __init__(self):
        self.o = Ocean(verbose=False)

    # ----- reading -----

    def state_counts(self) -> dict:
        """How many projects and documents the STATE app holds — the ground truth.

        `ce.ocean` is the logic third; `ce.ocean.state` is the durable store underneath it.
        Asking the store directly is the only way to tell an empty workspace apart from a
        logic app that cannot currently read it.
        """
        out = {}
        for prefix in ("project:", "doc:"):
            raw = self.o.client.request(
                self.o.provider, STATE_TOPIC,
                json.dumps({"op": "keys", "args": {"prefix": prefix}}), timeout_ms=90000)
            reply = json.loads(raw.decode("utf-8") or "{}")
            if "error" in reply:
                raise RuntimeError(reply["error"])
            res = reply.get("result") or {}
            out[prefix] = len(res.get("keys") or res or [])
        return out

    def assert_view_is_whole(self, t: list):
        """Refuse to destroy anything while the logic app is serving a partial view.

        `doc.tree` answers `ok: true` with a truncated tree when the logic app's read
        mirror is cold — it restarted at 21:36 on 2026-07-26 and reported one teamspace
        where the store held fourteen. Every emptiness test in this tool reads that view,
        so `teamspace rm` would cheerfully delete a teamspace that only LOOKS empty, and
        project.delete trashes everything inside. A destructive op therefore has to agree
        with the store's own count before it runs.
        """
        try:
            counts = self.state_counts()
        except Exception as e:  # noqa: BLE001 — no ground truth means no destroying
            sys.exit(f"ocean: cannot reach ce.ocean.state to verify the view ({e}); "
                     "refusing to delete anything")
        seen_projects, seen_docs = len(t), sum(1 for _ in self.docs(t))
        if seen_projects < counts["project:"] or seen_docs < counts["doc:"]:
            sys.exit(
                f"ocean: REFUSING — the logic app is serving a partial view.\n"
                f"  doc.tree shows {seen_projects} teamspace(s) and {seen_docs} document(s);\n"
                f"  ce.ocean.state holds {counts['project:']} and {counts['doc:']}.\n"
                f"  Nothing is lost — the store is intact and the logic app's read mirror is\n"
                f"  behind. Wait for it to catch up and run this again.")

    def tree(self, tries: int = 8) -> list:
        """Every teamspace, in a LIST, with its document tree hanging off it.

        A list and not a title->record dict, because Ocean lets two teamspaces carry the
        SAME NAME and a slow `project.create` is how you get one: the reply times out, the
        write lands anyway, and the next run creates a second. Keying by title hid exactly
        that on 2026-07-26 — the empty duplicate won the key, every move reported FAILED,
        and the pages had been filed correctly all along.
        """
        last = None
        for attempt in range(tries):
            try:
                return [p for org in self.o.call("doc.tree")["tree"]
                        for p in org.get("projects", [])]
            except Exception as e:  # noqa: BLE001 — a loaded laptop, not a missing server
                last = str(e)
                time.sleep(3 * (attempt + 1))
        sys.exit(f"ocean: cannot read the tree ({last})")

    def docs(self, t: list | None = None):
        """Every document, flattened, each tagged with the teamspace holding it."""
        for pr in (t if t is not None else self.tree()):
            stack = [(d, 0) for d in reversed(pr.get("docs", []))]
            while stack:
                doc, depth = stack.pop()
                yield pr, doc, depth
                stack.extend((c, depth + 1) for c in reversed(doc.get("children", [])))

    def spaces(self, ref: str, t: list | None = None) -> list:
        """Every teamspace matching a name or an id prefix — usually one, sometimes two."""
        t = t if t is not None else self.tree()
        return [p for p in t if norm(p["title"]) == norm(ref) or p["id"].startswith(ref)]

    def resolve(self, ref: str, t: list | None = None):
        """A teamspace name/id or a document id prefix -> ("project"|"doc", full id)."""
        t = t if t is not None else self.tree()
        found = self.spaces(ref, t)
        if len(found) > 1:
            ids = ", ".join(p["id"][:8] for p in found)
            sys.exit(f"ocean: {ref!r} names {len(found)} teamspaces ({ids}); use an id")
        if found:
            return "project", found[0]["id"]
        hits = [d["id"] for _, d, _ in self.docs(t) if d["id"].startswith(ref)]
        if len(hits) == 1:
            return "doc", hits[0]
        if hits:
            sys.exit(f"ocean: {ref!r} matches {len(hits)} documents; use more characters")
        sys.exit(f"ocean: no teamspace or document matching {ref!r}")

    # ----- writing -----

    def landed(self, op: str, args: dict, check, tries: int = 10) -> bool:
        """Call until the server shows the effect. `check()` re-reads and returns a bool.

        Ocean's replies time out long before its writes do, so "no reply" says nothing
        about whether the work happened. Asking first is what makes every command here
        safe to run twice.
        """
        for attempt in range(tries):
            if check():
                return True
            try:
                self.o.call(op, args, tries=1)
            except Exception as e:  # noqa: BLE001
                print(f"  {op}: {str(e)[:70]}", file=sys.stderr)
                time.sleep(3 * (attempt + 1))
        return check()


def show(doc, indent):
    kids = doc.get("children") or []
    tail = f"  ({len(kids)})" if kids else ""
    print(f"{' ' * indent}- {doc['title'][:88]}  [{doc['id'][:8]}]{tail}")


def cmd_tree(w: Workspace, a):
    t = w.tree()
    # Named a teamspace: show it in full, and show BOTH if the name is ambiguous, since
    # seeing the duplicate is the whole point of asking.
    chosen = w.spaces(a.teamspace, t) if a.teamspace else sorted(t, key=lambda p: p["title"])
    if a.teamspace and not chosen:
        sys.exit(f"ocean: no teamspace matching {a.teamspace!r}")
    for pr in chosen:
        total = sum(1 for _ in w.docs([pr]))
        print(f"\n{pr['title']}  [{pr['id'][:8]}]  {total} document(s)")
        depth = None if a.teamspace else 1
        for _, doc, d in w.docs([pr]):
            if depth is None or d <= depth:
                show(doc, 2 + d * 2)


def cmd_find(w: Workspace, a):
    res = w.o.call("search", {"q": a.text})
    for hit in (res or {}).get("results") or (res or {}).get("docs") or []:
        print(f"{hit.get('id','')[:8]}  {hit.get('title','')[:80]}")


def cmd_read(w: Workspace, a):
    kind, doc_id = w.resolve(a.id)
    if kind != "doc":
        sys.exit(f"ocean: {a.id!r} is a teamspace; use `tree` for it")
    res = w.o.call("doc.get", {"doc": doc_id})
    print((res.get("doc") or res).get("md", ""))


def cmd_new(w: Workspace, a):
    kind, target = w.resolve(a.where)
    md = ""
    if a.md:
        md = sys.stdin.read() if a.md == "-" else open(a.md).read()
    key = "project" if kind == "project" else "parent"
    doc_id = w.o.create_doc({key: target, "title": a.title, "md": md}, target, a.title)
    print(doc_id)


def cmd_mv(w: Workspace, a):
    t = w.tree()
    kind, doc_id = w.resolve(a.id, t)
    if kind != "doc":
        sys.exit("ocean: teamspaces do not nest; move the pages inside it instead")
    dest_kind, dest = w.resolve(a.dest, t)
    args = {"doc": doc_id, "project" if dest_kind == "project" else "parent": dest}

    def arrived():
        if dest_kind == "doc":
            try:
                rec = w.o.call("doc.get", {"doc": doc_id})
            except Exception:  # noqa: BLE001 — treat an unreadable answer as "not yet"
                return False
            return (rec.get("doc") or rec).get("parent") == dest
        return any(doc["id"] == doc_id and pr["id"] == dest for pr, doc, _ in w.docs())

    print("moved" if w.landed("doc.move", args, arrived) else "FAILED")


def cmd_rm(w: Workspace, a):
    t = w.tree()
    w.assert_view_is_whole(t)
    kind, doc_id = w.resolve(a.id, t)
    if kind != "doc":
        sys.exit("ocean: that is a teamspace; use `teamspace rm`")
    ok = w.landed("doc.delete", {"doc": doc_id},
                  lambda: not any(d["id"] == doc_id for _, d, _ in w.docs()))
    print("trashed" if ok else "FAILED")


def cmd_teamspace(w: Workspace, a):
    if a.action == "new":
        # `landed` asks before every attempt, so a create whose reply timed out but whose
        # write went through is adopted on the next pass instead of made twice.
        ok = w.landed("project.create",
                      {"org": w.o.org(), "name": a.name, "visibility": "open"},
                      lambda: bool(w.spaces(a.name)))
        found = w.spaces(a.name)
        print(found[0]["id"] if ok and found else "FAILED")
        return
    t = w.tree()
    w.assert_view_is_whole(t)
    found = w.spaces(a.name, t)
    if not found:
        sys.exit(f"ocean: no teamspace {a.name!r}")
    if len(found) > 1:
        ids = ", ".join(p["id"][:8] for p in found)
        sys.exit(f"ocean: {a.name!r} names {len(found)} teamspaces ({ids}); delete by id")
    pr = found[0]
    if pr.get("docs"):
        # project.delete trashes everything inside it. Emptying it first has to be a
        # deliberate act, not something a one-word command does by surprise.
        sys.exit(f"ocean: {a.name!r} still holds {len(pr['docs'])} page(s) — move them first")
    ok = w.landed("project.delete", {"project": pr["id"]},
                  lambda: not any(p["id"] == pr["id"] for p in w.tree()))
    print("deleted" if ok else "FAILED")


def main():
    ap = argparse.ArgumentParser(prog="ocean", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("tree", help="the workspace, or one teamspace in full")
    p.add_argument("teamspace", nargs="?")
    p.set_defaults(fn=cmd_tree)

    p = sub.add_parser("find", help="search every document")
    p.add_argument("text")
    p.set_defaults(fn=cmd_find)

    p = sub.add_parser("read", help="print a document's markdown")
    p.add_argument("id")
    p.set_defaults(fn=cmd_read)

    p = sub.add_parser("new", help="create a page in a teamspace or under a page")
    p.add_argument("where")
    p.add_argument("title")
    p.add_argument("--md", help="file to read the body from, or - for stdin")
    p.set_defaults(fn=cmd_new)

    p = sub.add_parser("mv", help="re-file a page")
    p.add_argument("id")
    p.add_argument("dest", help="teamspace name or parent page id")
    p.set_defaults(fn=cmd_mv)

    p = sub.add_parser("rm", help="move a page to the trash")
    p.add_argument("id")
    p.set_defaults(fn=cmd_rm)

    p = sub.add_parser("teamspace", help="create or delete a teamspace")
    p.add_argument("action", choices=("new", "rm"))
    p.add_argument("name")
    p.set_defaults(fn=cmd_teamspace)

    a = ap.parse_args()
    if not a.cmd:
        a = ap.parse_args(["tree"])
    a.fn(Workspace(), a)


if __name__ == "__main__":
    main()
