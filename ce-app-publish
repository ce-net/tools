#!/usr/bin/env bash
# ce-app-publish — transitional. The designed replacement is the ce-publish app (mesh-native, no ssh):
#
#   ce-publish app <repo> --build --via linux-amd64=hetzner
#
# That is the same one command (build both arches + upload + stamp + sign + publish), but the cross
# build runs THROUGH the rdev app over the mesh (capability-authed, NAT-traversing) instead of this
# script's raw ssh to the relay, and artifacts land in the node's durable /blobs.
# STATUS 2026-07-02: rdev file transfer is PAUSED by order (unstable live sync overwrote work), so
# --via is refused and THIS script remains the working cross-arch publish path until the pause lifts.
#
# ---- original: build a native ceapp for BOTH arches, upload the binaries to the durable ce-hub
# /blobs, fill the manifest digests, sign + publish. One command instead of the manual recipe.
#
#   tools/ce-app-publish <repo>            # e.g. tools/ce-app-publish ce-pubsub
#
# Requires: <repo>/ceapp.toml with [app].name + [native].bin (artifacts may be placeholders/absent).
# darwin-amd64 is built locally (this Mac's rust is x86_64/Rosetta -> host_target=darwin-amd64);
# linux-amd64 is built on the relay via tools/ce-build and uploaded from there. Then `ce app publish`.
set -euo pipefail
REPO="${1:?usage: ce-app-publish <repo>}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIR="$ROOT/$REPO"
HUB="https://ce-net.com"
RELAY="root@178.105.145.170"
RSH="ssh -o BatchMode=yes -i $HOME/.ssh/id_ed25519"
[ -f "$DIR/ceapp.toml" ] || { echo "no $REPO/ceapp.toml"; exit 1; }
NAME=$(grep -m1 '^name' "$DIR/ceapp.toml" | sed 's/.*= *//;s/"//g')
BIN=$(awk '/^\[native\]/{n=1} n&&/^bin/{sub(/.*= */,"");gsub(/"/,"");print;exit}' "$DIR/ceapp.toml")
BIN="${BIN:-$NAME}"
echo "==> publishing ceapp '$NAME' (bin=$BIN) from $REPO"

# Optional cargo build features from the manifest: `[build]` `features = ["gateway", ...]`. Some services
# (e.g. ce-storage's S3 gateway) gate their server behind a feature, so the published binary must enable it.
FEATURES=$(awk '/^\[build\]/{b=1} b&&/^features/{sub(/.*= *\[/,"");sub(/\].*/,"");gsub(/[" ]/,"");print;exit}' "$DIR/ceapp.toml")
FEATARG=""; [ -n "$FEATURES" ] && FEATARG="--features $FEATURES"
echo "==> build features: ${FEATURES:-none}"

echo "==> [1/5] build darwin-amd64 locally"
( cd "$DIR" && cargo build --release --bin "$BIN" $FEATARG >/tmp/ce-pub-$NAME-mac.log 2>&1 ) || { tail -20 /tmp/ce-pub-$NAME-mac.log; exit 1; }
MACBIN="$ROOT/.cargo-shared/release/$BIN"
[ -f "$MACBIN" ] || MACBIN="$DIR/target/release/$BIN"
MACSHA=$(shasum -a 256 "$MACBIN" | cut -d' ' -f1)
echo "    darwin-amd64 $MACSHA ($(echo "scale=1;$(stat -f%z "$MACBIN")/1048576"|bc)MB)"
curl -fsS -X PUT "$HUB/blobs/$MACSHA" --data-binary @"$MACBIN" >/dev/null && echo "    uploaded"

echo "==> [2/5] build linux-amd64 on the relay"
bash "$ROOT/tools/ce-build" "$REPO" "build --release --bin $BIN $FEATARG" >/tmp/ce-pub-$NAME-linux.log 2>&1 || { tail -20 /tmp/ce-pub-$NAME-linux.log; exit 1; }
LXSHA=$($RSH "$RELAY" "B=/root/ce-build/target-$REPO/release/$BIN; sha256sum \"\$B\"|cut -d' ' -f1")
$RSH "$RELAY" "curl -fsS -X PUT http://127.0.0.1:8970/blobs/\$(sha256sum /root/ce-build/target-$REPO/release/$BIN|cut -d' ' -f1) --data-binary @/root/ce-build/target-$REPO/release/$BIN >/dev/null"
echo "    linux-amd64 $LXSHA (uploaded from relay)"

echo "==> [3/5] write digests into $REPO/ceapp.toml"
python3 - "$DIR/ceapp.toml" "$MACSHA" "$LXSHA" <<'PY'
import sys,re
p,mac,lx=sys.argv[1],sys.argv[2],sys.argv[3]
s=open(p).read()
if '[native.artifacts]' not in s:
    s=s.rstrip()+f'\n\n[native.artifacts]\n"darwin-amd64" = "{mac}"\n"linux-amd64"  = "{lx}"\n'
else:
    s=re.sub(r'"darwin-amd64"\s*=\s*"[^"]*"', f'"darwin-amd64" = "{mac}"', s)
    s=re.sub(r'"linux-amd64"\s*=\s*"[^"]*"',  f'"linux-amd64"  = "{lx}"',  s)
    if '"darwin-amd64"' not in s or '"linux-amd64"' not in s:
        s=re.sub(r'(\[native\.artifacts\][^\[]*)', f'[native.artifacts]\n"darwin-amd64" = "{mac}"\n"linux-amd64"  = "{lx}"\n', s, count=1)
open(p,'w').write(s)
print("    digests written")
PY

echo "==> [4/5] sign + publish to the registry"
ce app publish "$DIR/ceapp.toml" --registry "$HUB" 2>&1 | sed 's/^/    /'

echo "==> [5/5] verify"
ce app info "$NAME" --registry "$HUB" 2>&1 | head -6 | sed 's/^/    /'
echo "==> done: $NAME is published. Install: ce app install $NAME --on fleet=mine --yes"
