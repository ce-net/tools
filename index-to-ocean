#!/usr/bin/env python3
"""Publish the ce-index documentation into Ocean (one document per page).

The source of truth is `ce-index/docs/*.md` — it lives in the repo so it travels with it,
per the self-containment law. Ocean gets the same text as a readable, linked document tree
so the workspace explains its own search engine without anyone cloning a repo.

This script is idempotent: running it again updates the documents it already created
instead of duplicating them.

Structure it builds in Ocean, under org "Rydenfalk":

    Search                                            (project)
      Search - the mesh-wide index and relation graph (doc: the index)
        Why a search engine, and why a graph
        How it works - census, crawl, rank, relate
        The relation graph
        The corpus contract
        Operating the index

Usage:
    tools/index-to-ocean [--dry-run]
"""
from __future__ import annotations

import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DOCS = os.path.join(ROOT, "ce-index", "docs")
OCEAN = os.path.join(ROOT, "ocean")

SERVICE = "ce.ocean"
CTL = "ocean/ctl"
ORG_NAME = "Rydenfalk"
PROJECT_NAME = "Search"
INDEX_TITLE = "Search - the mesh-wide index and relation graph"

sys.path.insert(0, OCEAN)
import ce  # noqa: E402  (the ocean app's vendored SDK)

# Ordered; the title is taken from each file's first `# ` heading.
PAGES = [
    ("00-why.md", "1"),
    ("01-how-it-works.md", "2"),
    ("02-the-relation-graph.md", "3"),
    ("corpus-contract.md", "4"),
    ("03-operating.md", "5"),
]

# Links from these pages into the REST of the workspace, added at publish time.
#
# They live here rather than in `ce-index/docs/*.md` on purpose: a wiki link to an Ocean
# document is meaningless to anyone who clones the repo, and the docs have to travel alone.
# The repo keeps the explanation; Ocean gets the explanation PLUS its own connective tissue.
#
# Every title is verified to exist before it is written. Ocean resolves a matching title to
# a document ID (links are identity-based), and a title that matches nothing is recorded as
# dangling — so an unverified link here would quietly point at nothing, or invent it.
RELATED = {
    "00-why.md": [
        ("2026-07-26 · a distributed mesh-wide recursive search engine; similarity and relation graph over everything",
