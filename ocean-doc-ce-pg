PROJECT = "ae50d8ea"          # Engineering
REPO = "https://github.com/ce-net/ce-pg"
REPO_WEB = "https://github.com/ce-net/ce-pg-web"

c = ce.connect().wait_ready()
TO = c.find_service("ce.ocean")[0]


def op(o, a=None, timeout=120000):
    r = json.loads(c.request(TO, "ocean/ctl", json.dumps({"op": o, "args": a or {}}),
                             timeout_ms=timeout).decode())
    if "error" in r:
        raise RuntimeError(f"{o}: {r['error']}")
    return r["result"]


def existing(title, parent=None):
    for d in op("doc.list", {"project": PROJECT})["docs"]:
        if d["title"] == title and (d.get("parent") or None) == parent:
            return d["id"]
    return None


def upsert(title, md, parent=None, icon=""):
    # `md.render` emits the DOC TITLE as the page heading, so a body that also opens
    # with `# Title` renders it twice. Strip a leading H1 that just repeats the title.
    body = md.lstrip("\n")
    first, _, rest = body.partition("\n")
    if first.strip().lstrip("# ").strip() == title.strip():
        md = rest.lstrip("\n")
    doc = existing(title, parent)
    if doc:
        op("doc.update", {"doc": doc, "md": md, "icon": icon})
        print(f"  updated  {doc}  {title}")
        return doc
    args = {"title": title, "md": md, "icon": icon}
    if parent:
        args["parent"] = parent
    else:
        args["project"] = PROJECT
    doc = op("doc.create", args)["id"]
    print(f"  created  {doc}  {title}")
    return doc


