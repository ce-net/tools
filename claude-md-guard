#!/usr/bin/env python3
"""Keep ~/ce-net/CLAUDE.md an index, not an archive.

CLAUDE.md is loaded into EVERY agent's context, EVERY session. It once reached 159 KB
(~40k tokens burned per agent per session) because every new verbatim directive was pasted
into it in full. This guard makes that impossible to repeat.

Rules enforced:
  1. CLAUDE.md stays under the byte budget.
  2. CLAUDE.md contains no verbatim quote blocks — those live in directives/<theme>.md.
  3. Every directives/<theme>.md is linked from CLAUDE.md and from directives/README.md.
  4. No theme file is orphaned, and no link points at a missing file.

Usage:
  tools/claude-md-guard          # check, exit 1 on violation
  tools/claude-md-guard --stats  # just print sizes
"""
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CLAUDE = os.path.join(ROOT, "CLAUDE.md")
DIRECTIVES = os.path.join(ROOT, "directives")

BUDGET = 24_000  # bytes. Raising this is not the fix — moving content out is.

FIX = """
  A new directive from Leif goes:
    1. VERBATIM into directives/<theme>.md  (append at the bottom, with a dated heading)
    2. as ONE line in the law index in CLAUDE.md, pointing at that theme file
  Reference material goes to REPOS.md / OPERATIONS.md / PLAN/ / the ce-net-* skills.
"""


def main() -> int:
    errors = []
    warnings = []

    if not os.path.exists(CLAUDE):
        print("claude-md-guard: no CLAUDE.md at " + CLAUDE, file=sys.stderr)
        return 1

    raw = open(CLAUDE, encoding="utf-8").read()
    size = len(raw.encode("utf-8"))

    if "--stats" in sys.argv:
        print(f"CLAUDE.md      {size:>8,} bytes  (budget {BUDGET:,})")
        for name in sorted(os.listdir(DIRECTIVES)) if os.path.isdir(DIRECTIVES) else []:
            p = os.path.join(DIRECTIVES, name)
            print(f"  directives/{name:<28} {os.path.getsize(p):>8,} bytes")
        return 0

    # 1. budget
    if size > BUDGET:
        errors.append(
            f"CLAUDE.md is {size:,} bytes, over the {BUDGET:,} byte budget by {size - BUDGET:,}.\n"
            f"  Every agent pays this on every session. Move content out; do not raise the budget."
        )

    # 2. no verbatim quote blocks
    quotes = [
        (n, l) for n, l in enumerate(raw.split("\n"), 1)
        if l.startswith(">") and not l.startswith(">>>")
    ]
    if quotes:
        lines = ", ".join(str(n) for n, _ in quotes[:8])
        more = f" (+{len(quotes) - 8} more)" if len(quotes) > 8 else ""
        errors.append(
            f"CLAUDE.md contains {len(quotes)} verbatim quote line(s) at line {lines}{more}.\n"
            f"  Quotes belong in directives/<theme>.md — CLAUDE.md carries the one-line law."
        )

    # 3/4. theme files <-> links
    if not os.path.isdir(DIRECTIVES):
        errors.append("directives/ is missing — the verbatim archive must exist.")
    else:
        themes = {
            f for f in os.listdir(DIRECTIVES)
            if f.endswith(".md") and f != "README.md"
        }
        linked = set(re.findall(r"directives/([A-Za-z0-9._-]+\.md)", raw))
        readme_path = os.path.join(DIRECTIVES, "README.md")
        readme = open(readme_path, encoding="utf-8").read() if os.path.exists(readme_path) else ""
        indexed = set(re.findall(r"\(\./([A-Za-z0-9._-]+\.md)\)", readme))

        for missing in sorted(linked - themes - {"README.md"}):
            errors.append(f"CLAUDE.md links directives/{missing}, which does not exist.")
        for orphan in sorted(themes - linked):
            errors.append(
                f"directives/{orphan} is not linked from CLAUDE.md — its laws are invisible to agents."
            )
        for orphan in sorted(themes - indexed):
            warnings.append(f"directives/{orphan} is not listed in directives/README.md.")

    for w in warnings:
        print(f"claude-md-guard: warning: {w}")

    if errors:
        print("claude-md-guard: FAILED\n", file=sys.stderr)
        for e in errors:
            print("  - " + e + "\n", file=sys.stderr)
        print(FIX, file=sys.stderr)
        return 1

    print(f"claude-md-guard: ok  ({size:,} / {BUDGET:,} bytes, "
          f"{100 * size // BUDGET}% of budget)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
