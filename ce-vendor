#!/usr/bin/env python3
"""ce-vendor — keep the copies of a shared Python module identical, until imports exist.

THIS TOOL IS A STOPGAP. The law is: never copy code between repos, and shared code is an SDK you
import (`directives/repos-and-distribution.md`). A generated, checksummed copy is still a copy.
The import path does not exist yet — `ceapp.toml` cannot declare a Python dependency, and
`ce/docs/ceapps-script.md` calls `[script].deps` a planned follow-up. Build that, and delete this.

THE PROBLEM. A ceapp must travel ALONE: a receiver with only that repo has to be able to
run it, so a Python app cannot `import` a sibling checkout and there is no PYTHONPATH the
node injects (adding one would mean changing the substrate, which is locked). The answer
the platform already uses everywhere else applies here too: a language toolchain is
INTERNAL BUILD TOOLING that produces a COMMITTED SELF-CONTAINED ARTIFACT which ceapp.toml
runs. `ce.py` and `capauth.py` in an app are that artifact -- build output, not a fork.

What was actually happening instead: 72 hand-maintained copies of `ce.py` in 6 divergent
versions and 51 of `capauth.py` in 9, each search-replaced for its app's env var. Only 6
of the 51 carried `iam_bin_name`, so 45 apps silently had no capability enforcement at all
when run as supervised daemons. That is what "copy-paste sharing" costs.

WHAT THIS TOOL GUARANTEES.

  1. One canonical file per module, in the repo that OWNS it (`ce-py/capauth.py`).
  2. Every consumer's copy is byte-identical to it, under a provenance header naming the
     source and carrying the canonical body's sha256.
  3. A hand-edit is DETECTABLE without the source repo present: the header records the
     body hash, so a lone repo can verify nobody edited its own vendored file.
  4. Sync REFUSES to clobber a copy that defines symbols the canonical does not. Several
     apps grew app-specific helpers inside their `capauth.py` (`ensure_pg_token`,
     `self_issue_drive`); overwriting those silently would delete working code. Move them
     to an app-local module first, then sync.

USAGE

    tools/ce-vendor check          # report drift; exit 1 if any (the CI/pre-push gate)
    tools/ce-vendor sync           # bring every consumer up to canonical
    tools/ce-vendor sync --only ocean,ce-org
    tools/ce-vendor status         # per-module summary

A consumer is discovered by CONVENTION: any top-level repo dir that already contains a
file of that name. New apps get the module by copying it in; the next `check` adopts them.
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# The canonical modules and the repo that OWNS each one. The owner is the repo whose
# README documents the module and whose tests cover it -- never a repo that merely uses it.
MODULES = [
    {"name": "capauth.py", "source": "ce-py/capauth.py", "repo": "ce-py",
     "url": "github.com/ce-net/ce-py"},
    {"name": "ce.py", "source": "ce-py/ce.py", "repo": "ce-py",
     "url": "github.com/ce-net/ce-py"},
    # A DOMAIN model belongs to the app that owns it, never to the generic SDK: ce-py must
    # never learn what an organization or a person is. So each of these ships from its own
    # app's sdk/ dir, and the owning app vendors it at its own root like any other consumer.
    {"name": "org.py", "source": "ce-org/sdk/py/org.py", "repo": "ce-org/sdk",
     "url": "github.com/ce-net/ce-org"},
    {"name": "staff.py", "source": "ce-staff/sdk/py/staff.py", "repo": "ce-staff/sdk",
     "url": "github.com/ce-net/ce-staff"},
    # The drive client. Five apps carried byte-identical copies of it (ocean, canvas-drive,
    # ce-files, ce-observer, ce-stream) with nothing keeping them that way — they were in
    # sync by luck, and the first divergence would have been silent. ce-drive owns it.
    {"name": "cedrive.py", "source": "ce-drive/sdk/py/cedrive.py", "repo": "ce-drive/sdk",
     "url": "github.com/ce-net/ce-drive"},
    {"name": "driveauth.py", "source": "ce-drive/sdk/py/driveauth.py", "repo": "ce-drive/sdk",
     "url": "github.com/ce-net/ce-drive"},
]

HEADER_MARK = "# ce-vendor:"
SKIP_DIRS = {".git", "node_modules", "__pycache__", "dist", "target", "archive",
             "PLAN", "tools", "directives", ".claude", "trash"}


def sha(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def header_for(mod: dict, body: str) -> str:
    # The source is named by its GITHUB path, never by a path in this workspace: a vendored
    # file travels to machines that have only the receiving repo, and a `~/ce-net/...` or
    # sibling-relative path dangles for every one of them.
    within = mod["source"].split("/", 1)[1] if "/" in mod["source"] else mod["source"]
    return (
        f"{HEADER_MARK} GENERATED FROM {within} in {mod['url']} -- DO NOT EDIT THIS COPY.\n"
        f"{HEADER_MARK} source-sha256: {sha(body)}\n"
        f"{HEADER_MARK} This file is build output vendored so the app travels alone. Fix the\n"
        f"{HEADER_MARK} bug in the canonical file and re-run `ce-vendor sync`; a hand edit\n"
        f"{HEADER_MARK} here is detected by `ce-vendor check` and fails the gate.\n"
    )


def split_header(text: str):
    """Return (recorded_sha or None, body). A file with no header is all body."""
    lines = text.split("\n")
    n, recorded = 0, None
    for line in lines:
        if not line.startswith(HEADER_MARK):
            break
        if "source-sha256:" in line:
            recorded = line.split("source-sha256:")[1].strip()
        n += 1
    return recorded, "\n".join(lines[n:])


def top_level_symbols(text: str) -> set:
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return set()
    out = set()
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            out.add(node.name)
        elif isinstance(node, ast.Assign):
            for t in node.targets:
                if isinstance(t, ast.Name) and t.id.isupper():
                    out.add(t.id)
    return out


def consumers(mod: dict) -> list:
    """Every top-level repo dir already carrying a file of this name (except the owner)."""
    found = []
    for entry in sorted(os.listdir(ROOT)):
        path = os.path.join(ROOT, entry)
        if not os.path.isdir(path) or entry in SKIP_DIRS or entry.startswith("."):
            continue
        if entry == mod["repo"]:
            continue
        target = os.path.join(path, mod["name"])
        if os.path.isfile(target):
            found.append(target)
    return found


def read(path: str) -> str:
    with open(path, "r", encoding="utf-8") as fh:
        return fh.read()


def classify(mod: dict, canonical: str, path: str) -> dict:
    """What state is this consumer copy in?"""
    text = read(path)
    recorded, body = split_header(text)
    rel = os.path.relpath(path, ROOT)
    if text == header_for(mod, canonical) + canonical:
        return {"path": rel, "state": "current"}
    if body == canonical and recorded is not None:
        # Body is right; the provenance header is an older format. Re-stamp.
        return {"path": rel, "state": "unstamped", "extra": []}
    if body == canonical:
        # Matches, but carries no provenance header — so a later hand-edit would not be
        # detectable from the file alone. Stamp it.
        return {"path": rel, "state": "unstamped", "extra": []}
    extra = top_level_symbols(body) - top_level_symbols(canonical)
    if recorded is not None and sha(body) != recorded:
        state = "hand-edited"          # header says one thing, body is another
    elif recorded is not None:
        state = "stale"                # honest copy of an older canonical
    else:
        state = "unvendored"           # never been through this tool
    return {"path": rel, "state": state, "extra": sorted(extra)}


def cmd_check(args) -> int:
    bad = 0
    for mod in MODULES:
        canonical = read(os.path.join(ROOT, mod["source"]))
        rows = [classify(mod, canonical, p) for p in consumers(mod)]
        drift = [r for r in rows if r["state"] != "current"]
        print(f"\n== {mod['name']}  (canonical: {mod['source']})")
        print(f"   {len(rows)} consumers, {len(rows) - len(drift)} current, {len(drift)} drifted")
        for r in sorted(drift, key=lambda r: (r["state"], r["path"])):
            extra = f"  [defines: {', '.join(r['extra'])}]" if r.get("extra") else ""
            print(f"   {r['state']:<12} {r['path']}{extra}")
        bad += len(drift)
    if bad:
        print(f"\n{bad} vendored file(s) differ from canonical. Run `ce-vendor sync`.")
        print("A copy listed with [defines: ...] carries app-specific code: move those")
        print("symbols to an app-local module BEFORE syncing, or they are lost.")
    else:
        print("\nAll vendored copies match canonical.")
    return 1 if bad else 0


def cmd_sync(args) -> int:
    only = {s.strip() for s in (args.only or "").split(",") if s.strip()}
    wrote, skipped, refused = 0, 0, 0
    for mod in MODULES:
        canonical = read(os.path.join(ROOT, mod["source"]))
        head = header_for(mod, canonical)
        for path in consumers(mod):
            repo = os.path.relpath(path, ROOT).split(os.sep)[0]
            if only and repo not in only:
                continue
            row = classify(mod, canonical, path)
            if row["state"] == "current":
                skipped += 1
                continue
            if row.get("extra") and not args.force:
                print(f"REFUSED {row['path']}: defines {', '.join(row['extra'])} "
                      f"(move to an app-local module, or --force to discard)")
                refused += 1
                continue
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(head + canonical)
            print(f"synced  {row['path']}  ({row['state']} -> current)")
            wrote += 1
    print(f"\n{wrote} synced, {skipped} already current, {refused} refused.")
    return 1 if refused else 0


def cmd_status(args) -> int:
    for mod in MODULES:
        canonical = read(os.path.join(ROOT, mod["source"]))
        rows = [classify(mod, canonical, p) for p in consumers(mod)]
        counts = {}
        for r in rows:
            counts[r["state"]] = counts.get(r["state"], 0) + 1
        detail = ", ".join(f"{v} {k}" for k, v in sorted(counts.items()))
        print(f"{mod['name']:<14} {len(rows):3d} consumers   {detail}")
    return 0


# --------------------------------------------------------------------------- inline mode
#
# A ce-comp cell is imported from a `blob:` URL, so it cannot `import` a sibling file — the
# recursive-frontend contract says a component is ONE self-contained ES module. Inlining is
# how a shared module survives that: the canonical source is spliced into a marked region of
# each cell, so the cell stays one module and the code still has exactly one home.

INLINE_BEGIN = "// ce-vendor:inline "
INLINE_END = "// ce-vendor:inline-end"

INLINES = [
    {"name": "mesh.js", "source": "ce-ts/browser/mesh.js",
     "url": "github.com/ce-net/ce-ts",
     # Cells are ES modules already; the export line is the module's public surface and has
     # no meaning once inlined into one.
     "strip": ("export {", "export default")},
]


def inline_body(mod: dict) -> str:
    src = read(os.path.join(ROOT, mod["source"]))
    keep = [ln for ln in src.split("\n")
            if not any(ln.startswith(p) for p in mod["strip"])]
    return "\n".join(keep).strip("\n")


def inline_targets(mod: dict) -> list:
    """Every file carrying this module's begin marker."""
    out = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
        for name in filenames:
            if not name.endswith(".js"):
                continue
            path = os.path.join(dirpath, name)
            try:
                if (INLINE_BEGIN + mod["name"]) in read(path):
                    out.append(path)
            except (OSError, UnicodeDecodeError):
                continue
    return sorted(out)


def splice(text: str, mod: dict, body: str) -> str:
    begin = INLINE_BEGIN + mod["name"]
    i = text.index(begin)
    line_end = text.index("\n", i) + 1
    j = text.index(INLINE_END, line_end)
    within = mod["source"].split("/", 1)[1] if "/" in mod["source"] else mod["source"]
    header = (f"{begin} from {within} in {mod['url']} -- DO NOT EDIT THIS REGION.\n"
              f"// ce-vendor:inline-sha256 {sha(body)}\n")
    return text[:i] + header + body + "\n" + text[j:]


def cmd_inline(args) -> int:
    changed = 0
    for mod in INLINES:
        body = inline_body(mod)
        targets = inline_targets(mod)
        print(f"\n== {mod['name']}  (canonical: {mod['source']})  {len(targets)} cell(s)")
        for path in targets:
            text = read(path)
            new = splice(text, mod, body)
            rel = os.path.relpath(path, ROOT)
            if new == text:
                print(f"   current  {rel}")
                continue
            if args.check:
                print(f"   DRIFTED  {rel}")
                changed += 1
                continue
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(new)
            print(f"   inlined  {rel}")
            changed += 1
    if args.check and changed:
        print(f"\n{changed} cell(s) carry a stale inline. Run `ce-vendor inline`.")
        return 1
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="ce-vendor", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("check", help="report drift; exit 1 if any")
    i = sub.add_parser("inline", help="splice inlined modules into ce-comp cells")
    i.add_argument("--check", action="store_true", help="report only; exit 1 on drift")
    s = sub.add_parser("sync", help="bring consumers up to canonical")
    s.add_argument("--only", default="", help="comma-separated repo names")
    s.add_argument("--force", action="store_true",
                   help="overwrite copies carrying app-specific symbols (DISCARDS them)")
    sub.add_parser("status", help="per-module summary")
    args = ap.parse_args()
    if args.cmd == "sync":
        return cmd_sync(args)
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "inline":
        return cmd_inline(args)
    return cmd_check(args)


if __name__ == "__main__":
    sys.exit(main())
